# Copy to .env and fill in. Never commit .env.

# Ethereum RPC endpoint (chain id 1).
# For production use a dedicated provider (Alchemy, Infura, QuickNode).
# Public fallback: https://eth.llamarpc.com
RPC_URL=

# Hex private key of the deployer wallet (64 chars, 0x prefix optional).
# Use a DEDICATED deployer wallet, never your main wallet.
PRIVATE_KEY=

# Filled in after running the deploy script
CONTRACT_ADDRESS=

# Deploy script options
POOL_NAME=Maple St Syndication
POOL_SYMBOL=MSS
# Cap in whole tokens (18 decimals)
CAP=1000000

# Mint script options
INVESTOR=
# Amount in whole tokens (18 decimals)
AMOUNT=250000

# Distribute script options — rental profits in ETH (decimal string)
AMOUNT_ETH=12.5
